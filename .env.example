# Is file ko .env naam se copy karo. .env KABHI GitHub par push mat karna (.gitignore mein hai).
# Production (Railway) mein ye sab "Variables" tab mein daalo. Koi bhi secret chat mein paste mat karo.

# --- App ---
PORT=3000
PUBLIC_BASE_URL=https://YOUR-APP.up.railway.app
DB_PATH=/data/orders.db

# --- DigiSeller ---
DIGISELLER_SELLER_ID=
DIGISELLER_API_KEY=
# Telegram username wali option ki ID (probe script se pata chalegi). Khali = naam se dhoondega.
DIGISELLER_USERNAME_OPTION_ID=
# Docs ke "goods delivered" section se confirm karke bharo. Khali = ye step skip.
DIGISELLER_DELIVER_URL_TEMPLATE=
DIGISELLER_DELIVER_METHOD=POST

# --- MyStars (NAYI key lo: purani chat mein expose ho chuki hai, bot mein /api_rotate se rotate karo) ---
MYSTARS_API_KEY=
# Optional. Khali = webhook band, sirf polling (phir bhi poora kaam karta hai).
MYSTARS_WEBHOOK_SECRET=

# --- On-chain payment (alag hot wallet!) ---
PAYMENT_CURRENCY=usdt_ton
WALLET_MNEMONIC=
TONCENTER_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
TONCENTER_KEY=
LOW_BALANCE_GRAM=1
LOW_BALANCE_USDT=10

# --- Safety limits (shuru mein chhote rakho) ---
MAX_STARS_AUTO=100
MAX_STARS_PER_DAY=1000

# --- Alerts (Telegram bot token + apna chat id) ---
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=

# --- Buyer ko dikhane wala support text ---
SUPPORT_TEXT=Please contact the seller via the Digiseller chat and mention your order number.
SWEEP_INTERVAL_SECONDS=30
